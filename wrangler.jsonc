{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-template-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "build": {
    "command": "npm run build:css",
    "watch_dir": "src",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RAFFLE_ROOM",
        "class_name": "RaffleRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaffleRoom"],
    },
  ],
}
